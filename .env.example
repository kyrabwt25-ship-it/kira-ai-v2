# انسخ هذا الملف باسم .env واملأ القيم (لا ترفع .env لأي مكان عام أبدًا)
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# هوية المطوّر الأساسي
DEVELOPER_EMAIL=kyrabwt22@gmail.com  # غيّره إلى بريد حساب المالك الفعلي

# --- الدفع ---
# رابط صفحة الدفع من بوابتك (Paymob/Fawry/Kashier..). المتغيرات المتاحة: {payment_id} {amount} {email}. لا يُعدّ هذا الإعداد وحده تكاملًا كاملًا.
PAYMENT_URL_TEMPLATE=
# سر التوقيع الذي ترسل به البوابة إشعار الدفع (HMAC-SHA256 للجسم الخام في الهيدر X-Signature؛ يلزم تكييف صيغة التوقيع حسب البوابة)
PAYMENT_WEBHOOK_SECRET=
# تعليمات الدفع اليدوي تظهر للطالب (إنستاباي/فودافون كاش..)
MANUAL_PAY_NOTE=حوّل المبلغ على الرقم ... ثم أرسل رقم الطلب وصورة التحويل على واتساب ...
# رقم فودافون كاش الذي يظهر للطالب مع زر النسخ
VCASH_NUMBER=01017332544

# --- النماذج ---
# أعلى نموذج للمطوّر (يتحوّل تلقائيًا للاحتياطي إن لم يتوفر لحسابك)
TOP_MODEL=claude-fable-5-1
FALLBACK_MODEL=claude-opus-5-5
